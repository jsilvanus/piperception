[Unit]
Description=PiPerception Person Detection and Tracking
After=network-online.target mediamtx.service fffleet-orchestrator.service

[Service]
WorkingDirectory=%h/apps/piperception
EnvironmentFile=%h/apps/piperception.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/node dist/main.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
