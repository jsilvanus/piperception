{
  "name": "piperception",
  "version": "0.1.0",
  "packageManager": "pnpm@11.23.0",
  "private": true,
  "type": "module",
  "description": "Real-time neural person detection, ByteTrack tracking, and 2D bounding box extraction service for PiSpace",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "piperception": "bin/piperception.mjs"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "fastify": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3"
  },
  "files": [
    "dist",
    "bin"
  ],
  "pi": {
    "service": "piperception",
    "displayName": "PiPerception",
    "port": 3110,
    "healthEndpoint": "/health",
    "envPortVar": "PORT"
  }
}
